PROGRAM SarahRevere(INPUT, OUTPUT);
VAR
  W1, W2, W3, W4, Looking: CHAR;
BEGIN
  W1 := ' ';
  W2 := ' ';
  W3 := ' ';
  W4 := ' ';
  Looking := 'Y';
  READ(W1);
  IF W1 = '#'
  THEN
    BEGIN
      W2 := '#';
      W3 := '#';
      W4 := '#';
    END
  ELSE
    BEGIN
      READ(W2);
      IF W2 = '#'
      THEN
        BEGIN
          W3 := '#';
          W4 := '#';
        END
      ELSE
        BEGIN
          READ(W3);
      IF W3 = '#'
      THEN
        W4 := '#';
      ELSE
        READ(W4);
        END;
  END;
  WHILE Looking = 'Y'
  DO
    BEGIN
      IF W1 = 'l'
      THEN
        IF W2 = 'a'
        THEN
          IF W3 = 'n'
          THEN
            IF W4 = 'd'
            THEN
              Looking := 'L';
      IF W1 = 's'
      THEN
        IF W2 = 'e'
        THEN
          IF W3 = 'a'
          THEN
            Looking := 'S';
      IF W4 = '#'
      THEN
        Looking := 'N'
     ELSE
       BEGIN
      W1 := W2;
      W2 := W3;
      W3 := W4;
      READ (W4);
        END
    END;
    IF Looking = 'L'
    THEN
      WRITELN('The British are coming by land.')
    ELSE
      IF Looking = 'S'
      THEN
        WRITELN('The British are coming by sea.')
      ELSE
  WRITElN('Sarah didn''t say');
END.